---
import '../styles/global.css';

export interface Props {
  title: string;
}
const { title } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
  <title>{title} | Castellano's Admin</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    body { background-color: #0A0A0A; color: #F9F9F6; font-family: system-ui, sans-serif; }
  </style>
</head>
<body>
  <nav class="border-b border-[#2A2A2A] bg-[#080808]">
    <div class="max-w-6xl mx-auto px-6 py-4 flex items-center justify-between">
      <div class="flex items-center gap-8">
        <span class="font-semibold tracking-wide text-[#B89B65]">Castellano's Admin</span>
        <a href="/admin" class="text-sm text-[#F9F9F6]/70 hover:text-[#F9F9F6]">Dashboard</a>
        <a href="/admin/menu" class="text-sm text-[#F9F9F6]/70 hover:text-[#F9F9F6]">Menu Editor</a>
      </div>
      <button id="sign-out-btn" class="text-sm text-[#F9F9F6]/70 hover:text-[#F9F9F6]">Sign out</button>
    </div>
  </nav>
  <main class="max-w-6xl mx-auto px-6 py-10">
    <slot />
  </main>
  <script>
    import { signOut } from 'auth-astro/client';
    document.getElementById('sign-out-btn')?.addEventListener('click', () => signOut({ callbackUrl: '/admin/login' }));
  </script>
</body>
</html>
