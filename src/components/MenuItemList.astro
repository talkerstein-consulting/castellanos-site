---
interface MenuItem {
  id: number;
  subheading: string | null;
  name: string;
  price: string;
  description: string | null;
  isNote: boolean;
}

interface Props {
  items: MenuItem[];
}

const { items } = Astro.props;

let lastSubheading: string | null | undefined = undefined;
const delays = [0, 100, 200, 300, 400];
---
<div class="max-w-xl mx-auto w-full space-y-16">
  {items.map((item, i) => {
    const showSubheading = item.subheading !== lastSubheading;
    lastSubheading = item.subheading;
    const delay = delays[i % delays.length];

    return (
      <>
        {showSubheading && item.subheading && (
          <div
            class="scroll-item opacity-0 translate-y-10 transition-all duration-1000 ease-out group mb-8"
            style={i > 0 ? 'padding-top: 2rem;' : ''}
          >
            <h3 class="font-playfair italic text-3xl md:text-4xl text-[#B89B65] border-b border-[#4A4A4A]/50 pb-4">{item.subheading}</h3>
          </div>
        )}

        {item.isNote ? (
          <div class="pt-8 border-t border-[#4A4A4A] flex justify-between items-baseline">
            <p class="text-[#B89B65] font-instrument-sans text-xs uppercase tracking-widest italic">* {item.name}</p>
            <span class="font-instrument-sans text-[#B89B65] text-xl tracking-widest pl-4">{item.price}</span>
          </div>
        ) : (
          <div class="scroll-item opacity-0 translate-y-10 transition-all duration-1000 ease-out group" style={`transition-delay: ${delay}ms;`}>
            <div class="flex justify-between items-baseline mb-3 border-b border-[#4A4A4A]/50 pb-2">
              <h4 class="font-playfair text-3xl md:text-4xl tracking-wide text-[#F9F9F6] group-hover:text-[#B89B65] transition-colors">{item.name}</h4>
              <span class="font-instrument-sans text-[#B89B65] text-xl tracking-widest pl-4">{item.price}</span>
            </div>
            {item.description && (
              <p class="text-[#F9F9F6]/80 font-instrument-sans font-light text-base leading-relaxed pr-12">{item.description}</p>
            )}
          </div>
        )}
      </>
    );
  })}
</div>
