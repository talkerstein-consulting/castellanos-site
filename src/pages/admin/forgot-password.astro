---
export const prerender = false;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
  <title>Forgot Password | Castellano's Admin</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    body { background-color: #080808; color: #F9F9F6; font-family: system-ui, sans-serif; }
  </style>
</head>
<body class="min-h-screen flex items-center justify-center px-4">
  <div class="w-full max-w-sm space-y-6">
    <div class="text-center">
      <h1 class="text-2xl font-semibold text-[#B89B65]">Reset your password</h1>
      <p class="text-[#F9F9F6]/60 text-sm mt-2">Enter the email on your admin account and we'll send a reset link, if it exists.</p>
    </div>

    <form id="forgot-form" class="space-y-3">
      <div>
        <label class="block text-xs text-[#F9F9F6]/50 mb-1">Email</label>
        <input type="email" name="email" required class="w-full bg-[#111111] border border-[#2A2A2A] rounded-sm px-3 py-2 text-sm" />
      </div>
      <button type="submit" id="submit-btn" class="w-full bg-[#B89B65] text-[#080808] px-6 py-3 rounded-sm font-medium hover:bg-[#F9F9F6] transition-colors">
        Send reset link
      </button>
    </form>

    <div id="success-msg" class="hidden text-center text-sm text-[#F9F9F6]/80">
      If that email exists, a reset link has been sent. Check your inbox.
    </div>

    <div class="text-center">
      <a href="/admin/login" class="text-xs text-[#F9F9F6]/50 hover:text-[#F9F9F6] underline">Back to sign in</a>
    </div>
  </div>

  <script>
    const form = document.getElementById('forgot-form');
    const submitBtn = document.getElementById('submit-btn');
    const successMsg = document.getElementById('success-msg');

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Sending...';
      }

      const formData = new FormData(form);
      await fetch('/api/admin/forgot-password', { method: 'POST', body: formData });

      form.classList.add('hidden');
      successMsg?.classList.remove('hidden');
    });
  </script>
</body>
</html>
