---
export const prerender = false;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
  <title>Forgot Password | Castellano's Admin</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:ital,wght@0,400..700;1,400..700&family=Instrument+Serif:ital@0;1&family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>

  <style>
    body {
      background-color: #080808;
      color: #F9F9F6;
      font-family: 'Instrument Sans', sans-serif;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .font-instrument-serif { font-family: 'Instrument Serif', serif; }
    .border-editorial {
      border: 1px solid #B89B65;
      position: relative;
    }
    .border-editorial::after {
      content: '';
      position: absolute;
      inset: 3px;
      border: 1px solid rgba(184, 155, 101, 0.3);
      pointer-events: none;
    }
    .bg-noise {
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)' opacity='0.05'/%3E%3C/svg%3E");
    }
  </style>
</head>
<body class="px-4 py-12">
  <div class="w-full max-w-md">

    <div class="text-center mb-10">
      <img src="/wp-content/uploads/2026/05/CR-new-logo-scaled.webp" alt="Castellano's Ristorante" class="w-40 md:w-48 mx-auto object-contain mb-6" />
      <p class="text-[#B89B65] text-xs tracking-[0.3em] uppercase font-instrument-sans">Admin Portal</p>
    </div>

    <div class="bg-[#0A0A0A] border-editorial relative p-8 md:p-10">
      <div class="absolute inset-0 bg-noise opacity-40 pointer-events-none"></div>

      <div class="relative z-10 space-y-6">
        <div class="text-center">
          <h1 class="font-instrument-serif italic text-2xl text-[#F9F9F6] mb-2">Reset your password</h1>
          <p class="text-[#F9F9F6]/60 text-sm">Enter the email on your admin account and we'll send a reset link, if it exists.</p>
        </div>

        <form id="forgot-form" class="space-y-5">
          <div>
            <label class="block text-xs tracking-[0.2em] uppercase text-[#F9F9F6]/60 mb-2">Email</label>
            <input type="email" name="email" required class="w-full bg-transparent border-b border-[#4A4A4A] text-[#F9F9F6] py-2 focus:outline-none focus:border-[#B89B65] transition-colors text-sm placeholder-[#F9F9F6]/40" />
          </div>
          <button type="submit" id="submit-btn" class="w-full border border-[#B89B65] text-[#B89B65] px-6 py-3 text-sm tracking-[0.2em] uppercase font-medium hover:bg-[#B89B65] hover:text-[#080808] transition-colors">
            Send reset link
          </button>
        </form>

        <div id="success-msg" class="hidden text-center text-sm text-[#F9F9F6]/80">
          If that email exists, a reset link has been sent. Check your inbox.
        </div>

        <div class="text-center">
          <a href="/admin/login" class="text-xs text-[#F9F9F6]/50 hover:text-[#B89B65] transition-colors underline underline-offset-2">Back to sign in</a>
        </div>
      </div>
    </div>
  </div>

  <script>
    const form = document.getElementById('forgot-form');
    const submitBtn = document.getElementById('submit-btn');
    const successMsg = document.getElementById('success-msg');

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Sending...';
      }

      const formData = new FormData(form);
      await fetch('/api/admin/forgot-password', { method: 'POST', body: formData });

      form.classList.add('hidden');
      successMsg?.classList.remove('hidden');
    });
  </script>
</body>
</html>
