---
export const prerender = false;
import { getSession } from 'auth-astro/server';

// If already signed in (and allowed), skip straight to the dashboard.
const session = await getSession(Astro.request);
if (session?.user) {
  return Astro.redirect('/admin');
}
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
  <title>Sign In | Castellano's Admin</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:ital,wght@0,400..700;1,400..700&family=Instrument+Serif:ital@0;1&family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet">

  <style>
    * { box-sizing: border-box; }
    body {
      margin: 0;
      background-color: #080808;
      color: #F9F9F6;
      font-family: 'Instrument Sans', sans-serif;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 3rem 1rem;
    }
    .wrap { width: 100%; max-width: 28rem; }
    .logo-block { text-align: center; margin-bottom: 2.5rem; }
    .logo-block img {
      width: 11rem;
      max-width: 80%;
      margin: 0 auto 1.5rem;
      display: block;
      object-fit: contain;
    }
    .eyebrow {
      color: #B89B65;
      font-size: 0.7rem;
      letter-spacing: 0.3em;
      text-transform: uppercase;
    }
    .card {
      background: #0A0A0A;
      border: 1px solid #B89B65;
      position: relative;
      padding: 2.5rem 2rem;
    }
    .card::after {
      content: '';
      position: absolute;
      inset: 3px;
      border: 1px solid rgba(184, 155, 101, 0.3);
      pointer-events: none;
    }
    .card::before {
      content: '';
      position: absolute;
      inset: 0;
      pointer-events: none;
      opacity: 0.4;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)' opacity='0.05'/%3E%3C/svg%3E");
    }
    .card-inner { position: relative; z-index: 1; }
    .card-inner > * + * { margin-top: 1.5rem; }

    .google-btn {
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.75rem;
      background: #F9F9F6;
      color: #080808;
      border: none;
      padding: 0.85rem 1.5rem;
      font-size: 0.875rem;
      font-weight: 500;
      letter-spacing: 0.02em;
      cursor: pointer;
      transition: background-color 0.15s ease;
    }
    .google-btn:hover { background: #ffffff; }
    .google-btn svg { width: 1.25rem; height: 1.25rem; }

    .divider { display: flex; align-items: center; gap: 0.75rem; color: rgba(249, 249, 246, 0.4); font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.2em; }
    .divider .line { flex: 1; border-top: 1px solid #4A4A4A; }

    form > * + * { margin-top: 1.25rem; }
    label {
      display: block;
      font-size: 0.7rem;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: rgba(249, 249, 246, 0.6);
      margin-bottom: 0.5rem;
    }
    input {
      width: 100%;
      background: transparent;
      border: none;
      border-bottom: 1px solid #4A4A4A;
      color: #F9F9F6;
      padding: 0.5rem 0;
      font-size: 0.875rem;
      font-family: inherit;
    }
    input::placeholder { color: rgba(249, 249, 246, 0.4); }
    input:focus { outline: none; border-bottom-color: #B89B65; }

    .submit-btn {
      width: 100%;
      background: transparent;
      border: 1px solid #B89B65;
      color: #B89B65;
      padding: 0.85rem 1.5rem;
      font-size: 0.875rem;
      font-weight: 500;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      cursor: pointer;
      transition: background-color 0.15s ease, color 0.15s ease;
      margin-top: 1.5rem;
    }
    .submit-btn:hover { background: #B89B65; color: #080808; }

    .forgot-row { text-align: center; padding-top: 0.25rem; }
    .forgot-row a, .back-link a {
      font-size: 0.75rem;
      color: rgba(249, 249, 246, 0.5);
      text-decoration: underline;
      text-underline-offset: 2px;
      transition: color 0.15s ease;
    }
    .forgot-row a:hover, .back-link a:hover { color: #B89B65; }

    .error-msg {
      color: #f87171;
      font-size: 0.875rem;
      text-align: center;
      padding-top: 0.25rem;
    }
    .hidden { display: none; }
  </style>
</head>
<body>
  <div class="wrap">

    <div class="logo-block">
      <img src="/wp-content/uploads/2026/05/CR-new-logo-scaled.webp" alt="Castellano's Ristorante" />
      <p class="eyebrow">Admin Portal</p>
    </div>

    <div class="card">
      <div class="card-inner">
        <button id="google-signin" class="google-btn">
          <svg viewBox="0 0 48 48"><path fill="#FFC107" d="M43.611,20.083H42V20H24v8h11.303c-1.649,4.657-6.08,8-11.303,8c-6.627,0-12-5.373-12-12s5.373-12,12-12c3.059,0,5.842,1.154,7.961,3.039l5.657-5.657C34.046,6.053,29.268,4,24,4C12.955,4,4,12.955,4,24s8.955,20,20,20s20-8.955,20-20C44,22.659,43.862,21.35,43.611,20.083z"/><path fill="#FF3D00" d="M6.306,14.691l6.571,4.819C14.655,15.108,18.961,12,24,12c3.059,0,5.842,1.154,7.961,3.039l5.657-5.657C34.046,6.053,29.268,4,24,4C16.318,4,9.656,8.337,6.306,14.691z"/><path fill="#4CAF50" d="M24,44c5.166,0,9.86-1.977,13.409-5.192l-6.19-5.238C29.211,35.091,26.715,36,24,36c-5.202,0-9.619-3.317-11.283-7.946l-6.522,5.025C9.505,39.556,16.227,44,24,44z"/><path fill="#1976D2" d="M43.611,20.083H42V20H24v8h11.303c-0.792,2.237-2.231,4.166-4.087,5.571c0.001-0.001,0.002-0.001,0.003-0.002l6.19,5.238C36.971,39.205,44,34,44,24C44,22.659,43.862,21.35,43.611,20.083z"/></svg>
          Sign in with Google
        </button>

        <div class="divider">
          <div class="line"></div>
          <span>or</span>
          <div class="line"></div>
        </div>

        <form id="credentials-form">
          <div>
            <label>Email</label>
            <input type="email" name="email" required />
          </div>
          <div>
            <label>Password</label>
            <input type="password" name="password" required />
          </div>
          <button type="submit" id="credentials-submit" class="submit-btn">Sign in</button>
        </form>

        <div class="forgot-row">
          <a href="/admin/forgot-password">Forgot password?</a>
        </div>

        <p id="signin-error" class="error-msg hidden">Sign-in failed — check your credentials or account authorization.</p>
      </div>
    </div>
  </div>

  <script>
    import { signIn } from 'auth-astro/client';

    document.getElementById('google-signin')?.addEventListener('click', () => signIn('google', { callbackUrl: '/admin' }));

    const form = document.getElementById('credentials-form');
    const errorMsg = document.getElementById('signin-error');
    const submitBtn = document.getElementById('credentials-submit');

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorMsg?.classList.add('hidden');
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Signing in...';
      }

      const formData = new FormData(form);
      // auth-astro's signIn(): with redirect:false, it returns the raw
      // Response object ONLY when sign-in failed; on success it returns
      // undefined (and has already set window.location.href itself).
      const res = await signIn('credentials', {
        email: formData.get('email'),
        password: formData.get('password'),
        redirect: false,
        callbackUrl: '/admin',
      });

      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Sign in';
      }

      if (res) {
        errorMsg?.classList.remove('hidden');
        return;
      }
      window.location.href = '/admin';
    });

    if (new URLSearchParams(window.location.search).get('error')) {
      errorMsg?.classList.remove('hidden');
    }
  </script>
</body>
</html>
