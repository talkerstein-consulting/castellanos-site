---
export const prerender = false;
const token = Astro.url.searchParams.get('token') || '';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
  <title>Reset Password | Castellano's Admin</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:ital,wght@0,400..700;1,400..700&family=Instrument+Serif:ital@0;1&family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet">

  <style>
    * { box-sizing: border-box; }
    body {
      margin: 0;
      background-color: #080808;
      color: #F9F9F6;
      font-family: 'Instrument Sans', sans-serif;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 3rem 1rem;
    }
    .wrap { width: 100%; max-width: 28rem; }
    .logo-block { text-align: center; margin-bottom: 2.5rem; }
    .logo-block img {
      width: 11rem;
      max-width: 80%;
      margin: 0 auto 1.5rem;
      display: block;
      object-fit: contain;
    }
    .eyebrow {
      color: #B89B65;
      font-size: 0.7rem;
      letter-spacing: 0.3em;
      text-transform: uppercase;
    }
    .card {
      background: #0A0A0A;
      border: 1px solid #B89B65;
      position: relative;
      padding: 2.5rem 2rem;
    }
    .card::after {
      content: '';
      position: absolute;
      inset: 3px;
      border: 1px solid rgba(184, 155, 101, 0.3);
      pointer-events: none;
    }
    .card::before {
      content: '';
      position: absolute;
      inset: 0;
      pointer-events: none;
      opacity: 0.4;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)' opacity='0.05'/%3E%3C/svg%3E");
    }
    .card-inner { position: relative; z-index: 1; }
    .card-inner > * + * { margin-top: 1.5rem; }

    .title-block { text-align: center; }
    .title-block h1 {
      font-family: 'Instrument Serif', serif;
      font-style: italic;
      font-size: 1.5rem;
      color: #F9F9F6;
      margin: 0;
    }

    .warning-msg { color: #f87171; font-size: 0.875rem; text-align: center; }

    form > * + * { margin-top: 1.25rem; }
    label {
      display: block;
      font-size: 0.7rem;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: rgba(249, 249, 246, 0.6);
      margin-bottom: 0.5rem;
    }
    input {
      width: 100%;
      background: transparent;
      border: none;
      border-bottom: 1px solid #4A4A4A;
      color: #F9F9F6;
      padding: 0.5rem 0;
      font-size: 0.875rem;
      font-family: inherit;
    }
    input::placeholder { color: rgba(249, 249, 246, 0.4); }
    input:focus { outline: none; border-bottom-color: #B89B65; }

    .submit-btn {
      width: 100%;
      background: transparent;
      border: 1px solid #B89B65;
      color: #B89B65;
      padding: 0.85rem 1.5rem;
      font-size: 0.875rem;
      font-weight: 500;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      cursor: pointer;
      transition: background-color 0.15s ease, color 0.15s ease;
      margin-top: 1.5rem;
    }
    .submit-btn:hover { background: #B89B65; color: #080808; }

    .error-msg { color: #f87171; font-size: 0.875rem; text-align: center; }
    .success-msg { text-align: center; font-size: 0.875rem; color: rgba(249, 249, 246, 0.8); }
    .success-msg a { color: #B89B65; text-decoration: underline; }
    .hidden { display: none; }
  </style>
</head>
<body>
  <div class="wrap">

    <div class="logo-block">
      <img src="/wp-content/uploads/2026/05/CR-new-logo-scaled.webp" alt="Castellano's Ristorante" />
      <p class="eyebrow">Admin Portal</p>
    </div>

    <div class="card">
      <div class="card-inner">
        <div class="title-block">
          <h1>Set a new password</h1>
        </div>

        {!token && (
          <p class="warning-msg">Missing or invalid reset link. Request a new one from the forgot-password page.</p>
        )}

        {token && (
          <form id="reset-form">
            <input type="hidden" name="token" value={token} />
            <div>
              <label>New password</label>
              <input type="password" name="password" required minlength="8" />
            </div>
            <div>
              <label>Confirm new password</label>
              <input type="password" name="confirmPassword" required minlength="8" />
            </div>
            <button type="submit" id="submit-btn" class="submit-btn">Set new password</button>
            <p id="error-msg" class="error-msg hidden"></p>
          </form>
        )}

        <div id="success-msg" class="success-msg hidden">
          Password updated. <a href="/admin/login">Sign in</a>.
        </div>
      </div>
    </div>
  </div>

  <script>
    const form = document.getElementById('reset-form');
    const submitBtn = document.getElementById('submit-btn');
    const errorMsg = document.getElementById('error-msg');
    const successMsg = document.getElementById('success-msg');

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorMsg?.classList.add('hidden');

      const formData = new FormData(form);
      if (formData.get('password') !== formData.get('confirmPassword')) {
        if (errorMsg) {
          errorMsg.textContent = "Passwords don't match.";
          errorMsg.classList.remove('hidden');
        }
        return;
      }

      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Saving...';
      }

      const res = await fetch('/api/admin/reset-password', { method: 'POST', body: formData });

      if (!res.ok) {
        const text = await res.text();
        if (errorMsg) {
          errorMsg.textContent = text || 'Something went wrong. The link may have expired.';
          errorMsg.classList.remove('hidden');
        }
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = 'Set new password';
        }
        return;
      }

      form.classList.add('hidden');
      successMsg?.classList.remove('hidden');
    });
  </script>
</body>
</html>
