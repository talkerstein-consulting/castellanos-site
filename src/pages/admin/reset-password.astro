---
export const prerender = false;
const token = Astro.url.searchParams.get('token') || '';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
  <title>Reset Password | Castellano's Admin</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    body { background-color: #080808; color: #F9F9F6; font-family: system-ui, sans-serif; }
  </style>
</head>
<body class="min-h-screen flex items-center justify-center px-4">
  <div class="w-full max-w-sm space-y-6">
    <div class="text-center">
      <h1 class="text-2xl font-semibold text-[#B89B65]">Set a new password</h1>
    </div>

    {!token && (
      <p class="text-red-400 text-sm text-center">Missing or invalid reset link. Request a new one from the forgot-password page.</p>
    )}

    {token && (
      <form id="reset-form" class="space-y-3">
        <input type="hidden" name="token" value={token} />
        <div>
          <label class="block text-xs text-[#F9F9F6]/50 mb-1">New password</label>
          <input type="password" name="password" required minlength="8" class="w-full bg-[#111111] border border-[#2A2A2A] rounded-sm px-3 py-2 text-sm" />
        </div>
        <div>
          <label class="block text-xs text-[#F9F9F6]/50 mb-1">Confirm new password</label>
          <input type="password" name="confirmPassword" required minlength="8" class="w-full bg-[#111111] border border-[#2A2A2A] rounded-sm px-3 py-2 text-sm" />
        </div>
        <button type="submit" id="submit-btn" class="w-full bg-[#B89B65] text-[#080808] px-6 py-3 rounded-sm font-medium hover:bg-[#F9F9F6] transition-colors">
          Set new password
        </button>
        <p id="error-msg" class="text-red-400 text-sm text-center hidden"></p>
      </form>
    )}

    <div id="success-msg" class="hidden text-center text-sm text-[#F9F9F6]/80">
      Password updated. <a href="/admin/login" class="text-[#B89B65] underline">Sign in</a>.
    </div>
  </div>

  <script>
    const form = document.getElementById('reset-form');
    const submitBtn = document.getElementById('submit-btn');
    const errorMsg = document.getElementById('error-msg');
    const successMsg = document.getElementById('success-msg');

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorMsg?.classList.add('hidden');

      const formData = new FormData(form);
      if (formData.get('password') !== formData.get('confirmPassword')) {
        if (errorMsg) {
          errorMsg.textContent = "Passwords don't match.";
          errorMsg.classList.remove('hidden');
        }
        return;
      }

      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Saving...';
      }

      const res = await fetch('/api/admin/reset-password', { method: 'POST', body: formData });

      if (!res.ok) {
        const text = await res.text();
        if (errorMsg) {
          errorMsg.textContent = text || 'Something went wrong. The link may have expired.';
          errorMsg.classList.remove('hidden');
        }
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = 'Set new password';
        }
        return;
      }

      form.classList.add('hidden');
      successMsg?.classList.remove('hidden');
    });
  </script>
</body>
</html>
