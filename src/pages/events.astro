---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Events & Venue Rental | Castellano's Ristorante">

<style>
    #event-form input:not([type="checkbox"]),
    #event-form select,
    #event-form textarea {
        border-top: none !important;
        border-left: none !important;
        border-right: none !important;
        border-bottom: 1px solid #4A4A4A !important;
        border-radius: 0 !important;
        box-shadow: none !important;
        background-color: transparent !important;
        padding-left: 0 !important;
        padding-right: 0 !important;
    }
    #event-form input:not([type="checkbox"]):focus,
    #event-form select:focus,
    #event-form textarea:focus {
        border-bottom-color: #B89B65 !important;
        outline: none !important;
    }
    #event-form input[type="date"] {
        color-scheme: dark;
    }
    #event-form input[type="checkbox"] {
        appearance: none;
        background-color: transparent;
        margin: 0;
        font: inherit;
        color: currentColor;
        width: 1.15em;
        height: 1.15em;
        border: 1px solid #4A4A4A;
        border-radius: 0.15em;
        display: grid;
        place-content: center;
        cursor: pointer;
    }
    #event-form input[type="checkbox"]::before {
        content: "";
        width: 0.65em;
        height: 0.65em;
        transform: scale(0);
        transition: 120ms transform ease-in-out;
        box-shadow: inset 1em 1em #B89B65;
        background-color: #B89B65;
        transform-origin: center;
        clip-path: polygon(14% 44%, 0 65%, 50% 100%, 100% 16%, 80% 0%, 43% 62%);
    }
    #event-form input[type="checkbox"]:checked::before {
        transform: scale(1);
    }
    #event-form input[type="checkbox"]:checked {
        border-color: #B89B65;
    }
</style>

<header class="relative h-[55vh] md:h-[65vh] flex flex-col items-center justify-center text-center overflow-hidden border-b border-[#4A4A4A]">
    <div class="absolute inset-0 z-0 bg-[#080808]">
        <img src="/wp-content/uploads/2026/04/the-atmosphere.jpg" alt="Events Background" class="w-full h-full object-cover opacity-20 scale-105 filter grayscale" />
        <div class="absolute inset-0 bg-noise opacity-50"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-[#080808] via-[#080808]/80 to-transparent"></div>
    </div>

    <div class="relative z-10 px-6 w-full max-w-[90rem] mx-auto flex flex-col items-center justify-center h-full pt-24 animate-fade-in">
        <span class="font-script text-6xl md:text-8xl text-[#B89B65] leading-none block mb-4">Exclusive</span>
        <h1 class="font-instrument-serif text-6xl md:text-9xl text-[#F9F9F6] leading-none mb-6 tracking-tighter uppercase">Gatherings</h1>
        <div class="w-12 h-[1px] bg-[#B89B65] mx-auto mb-8"></div>
        <p class="text-[#F9F9F6]/80 font-instrument-sans font-light text-base tracking-[0.2em] uppercase max-w-lg">
            Host your private events with us.
        </p>
    </div>
</header>

<main class="w-full bg-[#080808]">
    <section class="py-24 md:py-32 bg-[#0A0A0A] relative border-b border-[#4A4A4A]">
        <div class="max-w-[80rem] mx-auto px-6 md:px-12">

            <div class="text-center mb-16">
                <span class="font-instrument-serif italic text-3xl md:text-4xl text-[#B89B65] mb-4 block">Plan Your Event</span>
                <h2 class="font-instrument-serif text-5xl md:text-6xl text-[#F9F9F6] mb-6">Inquire About A Date</h2>
                <p class="text-[#F9F9F6]/80 font-instrument-sans font-light text-lg md:text-xl max-w-3xl mx-auto leading-relaxed">
                    Please provide the details of your upcoming event below. Our events director will reach out to discuss menus, availability, and tailored arrangements.
                </p>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-2 border border-[#B89B65] border-editorial scroll-item opacity-0 translate-y-10 transition-all duration-1000 ease-out">
                <div class="relative min-h-[320px] lg:min-h-full order-2 lg:order-1">
                    <img src="/media/atmosphere-photo.jpg" alt="" class="absolute inset-0 w-full h-full object-cover" />
                </div>

                <div class="bg-[#080808] p-8 md:p-14 relative order-1 lg:order-2">

                <div id="event-success-msg" class="text-center py-24 hidden animate-fade-in">
                    <span class="font-instrument-serif italic text-4xl md:text-5xl text-[#B89B65] mb-6 block">Inquiry Received.</span>
                    <p class="font-instrument-sans font-light text-lg md:text-xl text-[#F9F9F6]/90 max-w-md mx-auto leading-relaxed">
                        Thank you for considering Castellano's. Our Event Director will contact you shortly to discuss the details.
                    </p>
                </div>

                <form id="event-form" class="space-y-10 relative z-10">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-12">

                        <div class="relative group md:col-span-2">
                            <label class="block font-instrument-sans text-sm md:text-base tracking-[0.25em] uppercase text-[#F9F9F6]/80 mb-2">Full Name</label>
                            <input type="text" name="full_name" placeholder="Enter your full name" required class="w-full bg-transparent border-b border-[#4A4A4A] text-[#F9F9F6] py-3 focus:outline-none focus:border-[#B89B65] transition-colors font-instrument-sans text-lg placeholder-[#F9F9F6]/50">
                        </div>

                        <div class="relative group">
                            <label class="block font-instrument-sans text-sm md:text-base tracking-[0.25em] uppercase text-[#F9F9F6]/80 mb-2">Email Address</label>
                            <input type="email" name="email" placeholder="Enter your email address" required class="w-full bg-transparent border-b border-[#4A4A4A] text-[#F9F9F6] py-3 focus:outline-none focus:border-[#B89B65] transition-colors font-instrument-sans text-lg placeholder-[#F9F9F6]/50">
                        </div>

                        <div class="relative group">
                            <label class="block font-instrument-sans text-sm md:text-base tracking-[0.25em] uppercase text-[#F9F9F6]/80 mb-2">Phone Number</label>
                            <input type="tel" name="phone" placeholder="Enter your phone number" class="w-full bg-transparent border-b border-[#4A4A4A] text-[#F9F9F6] py-3 focus:outline-none focus:border-[#B89B65] transition-colors font-instrument-sans text-lg placeholder-[#F9F9F6]/50">
                        </div>

                        <div class="relative group">
                            <label class="block font-instrument-sans text-sm md:text-base tracking-[0.25em] uppercase text-[#F9F9F6]/80 mb-2">Event Date</label>
                            <input type="date" name="event_date" placeholder="Select an event date" required class="w-full bg-transparent border-b border-[#4A4A4A] text-[#F9F9F6] py-3 focus:outline-none focus:border-[#B89B65] transition-colors font-instrument-sans text-lg placeholder-[#F9F9F6]/50 cursor-pointer">
                        </div>

                        <div class="relative group">
                            <label class="block font-instrument-sans text-sm md:text-base tracking-[0.25em] uppercase text-[#F9F9F6]/80 mb-2">Estimated Guest Count</label>
                            <input type="number" name="guest_count" placeholder="Enter estimated guest count" required class="w-full bg-transparent border-b border-[#4A4A4A] text-[#F9F9F6] py-3 focus:outline-none focus:border-[#B89B65] transition-colors font-instrument-sans text-lg placeholder-[#F9F9F6]/50">
                        </div>

                        <div class="relative group md:col-span-2">
                            <label class="block font-instrument-sans text-sm md:text-base tracking-[0.25em] uppercase text-[#F9F9F6]/80 mb-2">Nature Of Event</label>
                            <div class="relative">
                                <select name="nature_of_event" required class="w-full bg-transparent border-b border-[#4A4A4A] text-[#F9F9F6] py-3 focus:outline-none focus:border-[#B89B65] transition-colors font-instrument-sans text-lg appearance-none cursor-pointer pr-10 rounded-none">
                                    <option value="" disabled selected class="text-[#080808]">Select an option</option>
                                    <option value="Corporate Event" class="text-[#080808]">Corporate Event</option>
                                    <option value="Wedding / Reception" class="text-[#080808]">Wedding / Reception</option>
                                    <option value="Birthday" class="text-[#080808]">Birthday</option>
                                    <option value="Anniversary" class="text-[#080808]">Anniversary</option>
                                    <option value="Other" class="text-[#080808]">Other</option>
                                </select>
                                <div class="absolute inset-y-0 right-0 flex items-center pointer-events-none text-[#F9F9F6]/50">
                                    <svg class="w-5 h-5 fill-current" viewBox="0 0 20 20"><path d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" fill-rule="evenodd"></path></svg>
                                </div>
                            </div>
                        </div>

                        <div class="relative group md:col-span-2">
                            <label class="block font-instrument-sans text-sm md:text-base tracking-[0.25em] uppercase text-[#F9F9F6]/80 mb-2">Additional Details</label>
                            <textarea name="message" rows="3" placeholder="Tell us a little bit more about your vision..." class="w-full bg-transparent border-b border-[#4A4A4A] text-[#F9F9F6] py-3 focus:outline-none focus:border-[#B89B65] transition-colors font-instrument-sans text-lg placeholder-[#F9F9F6]/50 resize-none"></textarea>
                        </div>
                    </div>

                    <div class="flex items-start space-x-4 pt-4 text-left">
                        <input type="checkbox" id="coordination_accept" name="coordination_accept" required class="mt-1 flex-shrink-0">
                        <label for="coordination_accept" class="font-instrument-sans font-light text-sm text-[#F9F9F6]/70 cursor-pointer leading-relaxed">
                            I confirm that the details provided above are accurate and I consent to being contacted by Castellano's Ristorante for the purpose of event coordination.
                        </label>
                    </div>

                    <div class="pt-8 flex flex-col items-center space-y-4">
                        <button id="event-submit-btn" type="submit" class="w-full md:w-auto !bg-transparent hover:!bg-[#B89B65] border border-[#B89B65] !text-[#B89B65] hover:!text-[#080808] px-16 py-4 text-sm md:text-base font-medium tracking-[0.25em] uppercase transition-all duration-500 outline-none shadow-none font-instrument-sans">
                            Submit Inquiry
                        </button>
                    </div>
                </form>

                </div>
            </div>
        </div>
    </section>
</main>

<script src="https://www.google.com/recaptcha/api.js?render=6LdwXdMsAAAAAF9vC9oUT89qYboWtwIJB7qmQ8Nt"></script>

<script>
document.addEventListener("DOMContentLoaded", () => {
    const observerOptions = {
        root: null,
        rootMargin: '0px 0px -100px 0px',
        threshold: 0.1
    };

    const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                entry.target.classList.add('opacity-100', 'translate-y-0');
                entry.target.classList.remove('opacity-0', 'translate-y-10');
            }
        });
    }, observerOptions);

    document.querySelectorAll('.scroll-item').forEach(el => observer.observe(el));

    const form = document.getElementById('event-form');
    const successMsg = document.getElementById('event-success-msg');
    const submitBtn = document.getElementById('event-submit-btn');

    if(form) {
        form.addEventListener('submit', (e) => {
            e.preventDefault();

            submitBtn.disabled = true;
            submitBtn.textContent = 'Sending...';
            submitBtn.classList.add('opacity-50', 'cursor-not-allowed');

            grecaptcha.ready(function() {
                grecaptcha.execute('6LdwXdMsAAAAAF9vC9oUT89qYboWtwIJB7qmQ8Nt', {action: 'submit'}).then(function(token) {

                    const formData = new FormData(form);
                    formData.append("form_type", "Events");
                    formData.append("g-recaptcha-response", token);
                    formData.append("page_url", window.location.href);

                    fetch('https://script.google.com/macros/s/AKfycbx-GKP3xvbx8QJCmBBNI2Wcqy1Ah4fWkO3zoSrys5tNm6K_nuQg_c2-gsdsXmn1Up2vfw/exec', {
                        method: 'POST',
                        mode: 'no-cors',
                        body: formData
                    }).then(() => {
                        form.classList.add('hidden');
                        successMsg.classList.remove('hidden');
                    }).catch((error) => {
                        console.error('Error:', error);
                        submitBtn.disabled = false;
                        submitBtn.textContent = 'Submit Inquiry';
                        submitBtn.classList.remove('opacity-50', 'cursor-not-allowed');
                    });

                });
            });
        });
    }
});
</script>

</Layout>
