---
import Layout from '../layouts/Layout.astro';
import MenuItemList from '../components/MenuItemList.astro';
import { db } from '../db/client';
import { menuItems } from '../db/schema';
import { and, eq, asc } from 'drizzle-orm';

// Dynamic (DB-backed) so the admin menu editor's changes show up immediately —
// this page can no longer be prerendered as static HTML.
export const prerender = false;

let itemsBySection: Record<string, any[]> = { antipasti: [], pizze: [], pasta: [], mains: [], desserts: [] };

try {
  const rows = await db
    .select()
    .from(menuItems)
    .where(eq(menuItems.isActive, true))
    .orderBy(asc(menuItems.section), asc(menuItems.sortOrder));

  for (const row of rows) {
    if (!itemsBySection[row.section]) itemsBySection[row.section] = [];
    itemsBySection[row.section].push(row);
  }
} catch (err) {
  console.error('Failed to load menu items from DB:', err);
}
---
<Layout
  title="Menu | Castellano's Ristorante Vaughan"
  description="Explore Castellano's full menu — antipasti, wood-fired pizze, handmade pasta & risotto, prime steaks and fresh seafood, rooted in authentic Italian culinary excellence."
  ogImage="/media/menu/pasta-risotto.webp"
>

<style>
    html {
        scroll-behavior: smooth;
    }
    .hide-scrollbar::-webkit-scrollbar {
        display: none;
    }
    .hide-scrollbar {
        -ms-overflow-style: none;
        scrollbar-width: none;
    }
    #subscribe-form input:not([type="checkbox"]),
    #subscribe-form select,
    #subscribe-form textarea {
        border-top: none !important;
        border-left: none !important;
        border-right: none !important;
        border-bottom: 1px solid #4A4A4A !important;
        border-radius: 0 !important;
        box-shadow: none !important;
        background-color: transparent !important;
        padding-left: 0 !important;
        padding-right: 0 !important;
    }
    #subscribe-form input:not([type="checkbox"]):focus,
    #subscribe-form select:focus,
    #subscribe-form textarea:focus {
        border-bottom-color: #B89B65 !important;
        outline: none !important;
    }
</style>

<header class="relative h-[60vh] flex flex-col items-center justify-center text-center overflow-hidden">
    <div class="absolute inset-0 z-0 bg-[#080808]">
        <img src="/media/tableside-fish-service.webp" alt="Menu Background" class="w-full h-full object-cover opacity-20 scale-105 filter grayscale" />
        <div class="absolute inset-0 bg-noise opacity-50"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-[#080808] via-[#080808]/80 to-transparent"></div>
    </div>

    <div class="relative z-10 px-6 w-full max-w-[90rem] mx-auto flex flex-col items-center justify-center h-full pt-24 animate-fade-in">
        <span class="font-script text-6xl md:text-8xl text-[#B89B65] leading-none block mb-4">A Symphony of</span>
        <h1 class="font-instrument-serif text-6xl md:text-9xl text-[#F9F9F6] leading-none mb-6 tracking-tighter uppercase">Flavors</h1>
        <div class="w-12 h-[1px] bg-[#B89B65] mx-auto mb-8"></div>
        <p class="text-[#F9F9F6]/80 font-instrument-sans font-light text-base tracking-[0.2em] uppercase max-w-lg">
            Rooted in authentic culinary excellence.
        </p>
    </div>
</header>

<main class="w-full bg-[#080808]">

    <div id="menu-sticky-nav" class="sticky z-40 w-full bg-[#080808]/95 backdrop-blur-md border-t-0 border-b border-[#4A4A4A] transition-all duration-300" style="top: 105px;">
        <div class="max-w-[90rem] mx-auto px-6 md:px-12">
            <ul class="flex items-center justify-start md:justify-center space-x-8 md:space-x-12 overflow-x-auto py-4 hide-scrollbar font-instrument-sans text-sm md:text-base tracking-[0.2em] uppercase whitespace-nowrap">
                <li><a href="#antipasti" class="menu-nav-link !text-[#B89B65] hover:!text-[#B89B65] focus:!text-[#B89B65] outline-none transition-colors">Insalate & Antipasti</a></li>
                <li><a href="#pizze" class="menu-nav-link text-[#F9F9F6]/60 hover:!text-[#B89B65] focus:!text-[#B89B65] outline-none transition-colors">Pizze</a></li>
                <li><a href="#pasta" class="menu-nav-link text-[#F9F9F6]/60 hover:!text-[#B89B65] focus:!text-[#B89B65] outline-none transition-colors">Pasta & Risotto</a></li>
                <li><a href="#mains" class="menu-nav-link text-[#F9F9F6]/60 hover:!text-[#B89B65] focus:!text-[#B89B65] outline-none transition-colors">The Mains</a></li>
                <li><a href="#desserts" class="menu-nav-link text-[#F9F9F6]/60 hover:!text-[#B89B65] focus:!text-[#B89B65] outline-none transition-colors">Desserts</a></li>
            </ul>
        </div>
    </div>

    <section id="antipasti" class="flex flex-col md:flex-row relative w-full border-b border-[#1A1A1A] scroll-mt-[160px] md:scroll-mt-[180px]">

        <div class="w-full md:w-1/2 h-[50vh] md:h-screen md:sticky md:top-0 relative overflow-hidden group">
            <img src="/media/menu/antipasti.webp" alt="" class="absolute inset-0 w-full h-full object-cover z-0 transition-transform duration-1000 group-hover:scale-105" />
            <div class="absolute inset-0 bg-black/40 z-10 pointer-events-none"></div>
            <div class="absolute inset-0 bg-gradient-to-t from-[#080808]/90 via-[#080808]/40 to-transparent z-10 pointer-events-none"></div>
            <div class="absolute inset-0 flex flex-col justify-center items-center z-20 pointer-events-none text-center px-8">
                <div class="translate-y-4 group-hover:translate-y-0 transition-transform duration-700">
                    <span class="font-playfair italic text-xl md:text-2xl text-[#B89B65] mb-2 block">To Begin</span>
                    <h2 class="font-instrument-serif text-5xl md:text-7xl text-[#F9F9F6]">Insalate &<br>Antipasti</h2>
                </div>
            </div>
        </div>

        <div class="w-full md:w-1/2 min-h-screen bg-[#0A0A0A] px-8 py-24 md:px-16 lg:px-24 flex flex-col justify-center relative z-10">
            <MenuItemList items={itemsBySection.antipasti} />
        </div>
    </section>

    <section id="pizze" class="flex flex-col md:flex-row-reverse relative w-full border-b border-[#1A1A1A] scroll-mt-[160px] md:scroll-mt-[180px]">

        <div class="w-full md:w-1/2 h-[50vh] md:h-screen md:sticky md:top-0 relative overflow-hidden group">
            <img src="/media/menu/dal-forne-pizze.webp" alt="" class="absolute inset-0 w-full h-full object-cover z-0 transition-transform duration-1000 group-hover:scale-105" />
            <div class="absolute inset-0 bg-black/40 z-10 pointer-events-none"></div>
            <div class="absolute inset-0 bg-gradient-to-t from-[#080808]/90 via-[#080808]/40 to-transparent z-10 pointer-events-none"></div>
            <div class="absolute inset-0 flex flex-col justify-center items-center z-20 pointer-events-none text-center px-8">
                <div class="translate-y-4 group-hover:translate-y-0 transition-transform duration-700">
                    <span class="font-playfair italic text-xl md:text-2xl text-[#B89B65] mb-2 block">Dal Forno</span>
                    <h2 class="font-instrument-serif text-5xl md:text-7xl text-[#F9F9F6]">Pizze</h2>
                </div>
            </div>
        </div>

        <div class="w-full md:w-1/2 min-h-screen bg-[#080808] px-8 py-24 md:px-16 lg:px-24 flex flex-col justify-center relative z-10">
            <MenuItemList items={itemsBySection.pizze} />
        </div>
    </section>

    <section id="pasta" class="flex flex-col md:flex-row relative w-full border-b border-[#1A1A1A] scroll-mt-[160px] md:scroll-mt-[180px]">

        <div class="w-full md:w-1/2 h-[50vh] md:h-screen md:sticky md:top-0 relative overflow-hidden group">
            <img src="/media/menu/pasta-risotto.webp" alt="" class="absolute inset-0 w-full h-full object-cover z-0 transition-transform duration-1000 group-hover:scale-105" />
            <div class="absolute inset-0 bg-black/40 z-10 pointer-events-none"></div>
            <div class="absolute inset-0 bg-gradient-to-t from-[#080808]/90 via-[#080808]/40 to-transparent z-10 pointer-events-none"></div>
            <div class="absolute inset-0 flex flex-col justify-center items-center z-20 pointer-events-none text-center px-8">
                <div class="translate-y-4 group-hover:translate-y-0 transition-transform duration-700">
                    <span class="font-playfair italic text-xl md:text-2xl text-[#B89B65] mb-2 block">Handmade</span>
                    <h2 class="font-instrument-serif text-5xl md:text-7xl text-[#F9F9F6]">Pasta &<br>Risotto</h2>
                </div>
            </div>
        </div>

        <div class="w-full md:w-1/2 min-h-screen bg-[#0A0A0A] px-8 py-24 md:px-16 lg:px-24 flex flex-col justify-center relative z-10">
            <MenuItemList items={itemsBySection.pasta} />
        </div>
    </section>

    <section id="mains" class="flex flex-col md:flex-row-reverse relative w-full border-b border-[#1A1A1A] scroll-mt-[160px] md:scroll-mt-[180px]">

        <div class="w-full md:w-1/2 h-[50vh] md:h-screen md:sticky md:top-0 relative overflow-hidden group">
            <img src="/media/menu/the-mains.webp" alt="" class="absolute inset-0 w-full h-full object-cover z-0 transition-transform duration-1000 group-hover:scale-105" />
            <div class="absolute inset-0 bg-black/40 z-10 pointer-events-none"></div>
            <div class="absolute inset-0 bg-gradient-to-t from-[#080808]/90 via-[#080808]/40 to-transparent z-10 pointer-events-none"></div>
            <div class="absolute inset-0 flex flex-col justify-center items-center z-20 pointer-events-none text-center px-8">
                <div class="translate-y-4 group-hover:translate-y-0 transition-transform duration-700">
                    <span class="font-playfair italic text-xl md:text-2xl text-[#B89B65] mb-2 block">La Carne e Pesce</span>
                    <h2 class="font-instrument-serif text-5xl md:text-7xl text-[#F9F9F6]">The Mains</h2>
                </div>
            </div>
        </div>

        <div class="w-full md:w-1/2 min-h-screen bg-[#080808] px-8 py-24 md:px-16 lg:px-24 flex flex-col justify-center relative z-10">
            <MenuItemList items={itemsBySection.mains} />
        </div>
    </section>

    <section id="desserts" class="flex flex-col md:flex-row relative w-full scroll-mt-[160px] md:scroll-mt-[180px]">

        <div class="w-full md:w-1/2 h-[50vh] md:h-screen md:sticky md:top-0 relative overflow-hidden group">
            <img src="/media/menu/dessert.webp" alt="" class="absolute inset-0 w-full h-full object-cover z-0 transition-transform duration-1000 group-hover:scale-105" />
            <div class="absolute inset-0 bg-black/40 z-10 pointer-events-none"></div>
            <div class="absolute inset-0 bg-gradient-to-t from-[#080808]/90 via-[#080808]/40 to-transparent z-10 pointer-events-none"></div>
            <div class="absolute inset-0 flex flex-col justify-center items-center z-20 pointer-events-none text-center px-8">
                <div class="translate-y-4 group-hover:translate-y-0 transition-transform duration-700">
                    <span class="font-playfair italic text-xl md:text-2xl text-[#B89B65] mb-2 block">Dolce</span>
                    <h2 class="font-instrument-serif text-5xl md:text-7xl text-[#F9F9F6]">Desserts</h2>
                </div>
            </div>
        </div>

        <div class="w-full md:w-1/2 min-h-screen bg-[#0A0A0A] px-8 py-24 md:px-16 lg:px-24 flex flex-col justify-center relative z-10">
            <MenuItemList items={itemsBySection.desserts} />
        </div>
    </section>

    <!-- Full Width Atmosphere Image Section (CTA strip) -->
    <section class="w-full min-h-[45vh] md:min-h-[55vh] flex flex-col items-center justify-center relative overflow-hidden group border-t border-[#4A4A4A] py-20">
        <div class="absolute inset-0 bg-cover bg-center grayscale opacity-40 transition-transform duration-1000 group-hover:scale-105" style="background-image: url('/media/atmosphere-photo.jpg');"></div>
        <div class="absolute inset-0 bg-noise opacity-30"></div>
        <div class="absolute inset-0 bg-[#080808]/60 group-hover:bg-[#080808]/50 transition-colors duration-500"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-[#080808] via-transparent to-[#080808]/40"></div>

        <div class="relative z-10 px-6 max-w-4xl mx-auto text-center scroll-item opacity-0 translate-y-10 transition-all duration-1000 ease-out">
            <span class="font-instrument-sans text-[#B89B65] text-sm tracking-[0.3em] uppercase mb-6 block">The Experience Awaits</span>
            <h2 class="font-instrument-serif text-5xl md:text-7xl text-[#F9F9F6] mb-6">We can't wait to host you.</h2>
            <p class="text-[#F9F9F6]/80 font-instrument-sans font-light text-base md:text-lg max-w-xl mx-auto leading-relaxed">
                Prepare for an evening where every detail is meticulously curated. We look forward to pouring your glass and welcoming you to our table.
            </p>
        </div>
    </section>

</main>

<script>
document.addEventListener("DOMContentLoaded", () => {
    // --- Keep the sticky menu nav pinned right below the real (animated) header height ---
    const navbar = document.getElementById('navbar');
    const menuStickyNav = document.getElementById('menu-sticky-nav');

    function syncMenuNavOffset() {
        if (navbar && menuStickyNav) {
            menuStickyNav.style.top = `${navbar.getBoundingClientRect().height}px`;
        }
    }

    syncMenuNavOffset();
    window.addEventListener('scroll', syncMenuNavOffset, { passive: true });
    window.addEventListener('resize', syncMenuNavOffset);

    const observerOptions = {
        root: null,
        rootMargin: '0px 0px -100px 0px',
        threshold: 0.1
    };

    const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                entry.target.classList.add('opacity-100', 'translate-y-0');
                entry.target.classList.remove('opacity-0', 'translate-y-10');
            }
        });
    }, observerOptions);

    document.querySelectorAll('.scroll-item').forEach(el => observer.observe(el));

    const menuSections = document.querySelectorAll('main section[id]');
    const menuNavLinks = document.querySelectorAll('.menu-nav-link');

    const sectionObserverOptions = {
        root: null,
        rootMargin: '-190px 0px -60% 0px',
        threshold: 0
    };

    const sectionObserver = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                const id = entry.target.getAttribute('id');

                menuNavLinks.forEach(link => {
                    link.classList.remove('!text-[#B89B65]');
                    link.classList.add('text-[#F9F9F6]/60');

                    if (link.getAttribute('href') === `#${id}`) {
                        link.classList.remove('text-[#F9F9F6]/60');
                        link.classList.add('!text-[#B89B65]');

                        link.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
                    }
                });
            }
        });
    }, sectionObserverOptions);

    menuSections.forEach(section => sectionObserver.observe(section));
});
</script>
</Layout>
