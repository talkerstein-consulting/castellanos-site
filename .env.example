# Google reCAPTCHA v3 site key (public — safe to expose client-side)
# Get one at https://www.google.com/recaptcha/admin
PUBLIC_RECAPTCHA_SITE_KEY=your-recaptcha-site-key-here

# reCAPTCHA v3 secret key (server-only, never exposed to the client)
# Leave unset to skip server-side verification.
RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key-here

# SMTP settings used by src/pages/api/submit-form.ts to email form submissions
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=hello@castellanosristorante.com
SMTP_PASS=your-mailbox-password-here

# Where form submissions get delivered (defaults to info@castellanosristorante.ca)
FORM_RECIPIENT_EMAIL=info@castellanosristorante.ca

# --- Admin portal (MySQL + Google OAuth) ---

# Either DATABASE_URL, or the discrete DB_* vars below — DATABASE_URL wins if both are set.
DATABASE_URL=mysql://user:pass@localhost:3306/castellanos
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Google OAuth client (Google Cloud Console → APIs & Services → Credentials).
# Authorized redirect URI must be: https://castellanosristorante.ca/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Auth.js session secret — generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_TRUST_HOST=true

# Comma-separated list of Google account emails allowed to sign in to /admin
ADMIN_EMAILS=you@example.com,staff@example.com

# NOTE re: Hostinger + this Astro/Vite app — import.meta.env.X is baked in at
# BUILD time, not read live at request time. Changing any of these in
# Hostinger's env-var UI requires a fresh rebuild (redeploy), not just an
# app restart, before the new value takes effect. Also avoid # & ' " \ and
# spaces in any value pasted into Hostinger's env-var editor — it has been
# observed to silently corrupt values containing those characters.
